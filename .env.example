# MySQL credentials.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
 
# quotes mysql host port (3308 avoids clashing with ai-builder's mysql on 3307
# and the main flowpos-backend mysql on 3306)
MYSQL_HOST_PORT=3308

FLOWPOS_SIGNING_SECRET=

# FlowPOS API this app calls on the tenant's behalf (fetching products,
# customers, etc., using the API key handed over on /install).
FLOWPOS_API_URL=

# Origins allowed to complete the apps-sdk postMessage handshake (theme
# sync, etc.) when this app is embedded in tenant-dashboard.
VITE_FLOWPOS_DASHBOARD_ORIGINS=https://app.flowpos.dev


JWT_SECRET=
